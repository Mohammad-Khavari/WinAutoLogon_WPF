<Window x:Name="FrmKioDetector" x:Class="WinAutoLogon_WPF.FrmKioskDetector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinAutoLogon_WPF"
        mc:Ignorable="d" Height="154" Width="562" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" SourceInitialized="FrmKioDetector_Load" WindowStyle="None">
    <Grid x:Name="MainGrid" Margin="0,0,2,0">
        <Button x:Name="BtnExit" Click="Exit" Content="Exit" Margin="232,115,232,0" VerticalAlignment="Top" Height="22" RenderTransformOrigin="0.589,1.205"/>
        <Label Content="Custom Shell:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="16" Width="74" Padding="0,0,0,0"/>
        <Label Content="Shell Launcher Configured:" HorizontalAlignment="Left" Margin="10,94,0,0" VerticalAlignment="Top" Height="16" Width="145" Padding="0,0,0,0"/>
        <Label Content="Assigned Access Configured:" HorizontalAlignment="Left" Margin="10,73,0,0" VerticalAlignment="Top" Height="16" Width="153" Padding="0,0,0,0"/>
        <Label Content="Shell Path:" HorizontalAlignment="Left" Margin="10,52,0,0" VerticalAlignment="Top" Height="16" Width="57" Padding="0,0,0,0"/>
        <Label Content="Shell Name:" HorizontalAlignment="Left" Margin="10,31,0,0" VerticalAlignment="Top" Height="16" Width="67" Padding="0,0,0,0"/>
        <Label x:Name="lblCustom" Content="INFO" HorizontalAlignment="Left" Margin="89,10,0,0" VerticalAlignment="Top" Height="16" Padding="0,0,0,0"/>
        <Label x:Name="lblShellLuncher" Content="INFO" HorizontalAlignment="Left" Margin="160,94,0,0" VerticalAlignment="Top" Height="16" Padding="0,0,0,0"/>
        <Label x:Name="lblAssigned" Content="INFO" HorizontalAlignment="Left" Margin="168,73,0,0" VerticalAlignment="Top" Height="16" Padding="0,0,0,0" RenderTransformOrigin="4.406,3.333"/>
        <Label x:Name="lblSource" Content="INFO" HorizontalAlignment="Left" Margin="70,52,0,0" VerticalAlignment="Top" Height="16" Padding="0,0,0,0"/>
        <Label x:Name="lblShell" Content="INFO" HorizontalAlignment="Left" Margin="82,31,0,0" VerticalAlignment="Top" Height="16" Padding="0,0,0,0" RenderTransformOrigin="-0.167,0.646"/>
        <TextBox x:Name="txtShellPath" HorizontalAlignment="Left" Margin="67,50,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="445" Background="#FFE0BEBE" d:Visibility="Visible" Visibility="Collapsed">
            <TextBox.Effect>
                <DropShadowEffect/>
            </TextBox.Effect>
        </TextBox>
        <Button x:Name="btnShellOK" Click="Exit" Content="OK" Margin="517,50,0,0" VerticalAlignment="Top" Height="18" RenderTransformOrigin="0.589,1.205" Padding="-1,1,1,1" Background="#FFF3F0A5" Visibility="Collapsed" d:Visibility="Visible" HorizontalAlignment="Left" Width="33">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Label x:Name="lblMsgG" Content="KIOSK Activated!" Margin="216,72,216,0" VerticalAlignment="Top" Padding="0,0,0,0" RenderTransformOrigin="4.406,3.333" Foreground="#FF28D022" FontWeight="Bold" FontSize="16" Visibility="Hidden"/>

    </Grid>
</Window>
