<Window x:Name="FrmMain" x:Class="WinAutoLogon_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinAutoLogon_WPF"
        mc:Ignorable="d"
        Title="Auto Logon" Height="303" Width="520">
    <Grid x:Name="BtnShowPW">
        <Label Content="Username:" x:Name="lblUsername" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Separator VerticalAlignment="Top" Height="4" Margin="0,117,0,0"/>
        <Label Content="Domain:" x:Name="lblDomain" HorizontalAlignment="Left" Margin="10,36,0,0" VerticalAlignment="Top"/>
        <Label Content="Password:" x:Name="lblPassword" HorizontalAlignment="Left" Margin="10,62,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.387,0.288"/>
        <Button Content="Check" x:Name="btnDecrypt" HorizontalAlignment="Left" Margin="10,93,0,0" VerticalAlignment="Top" Width="66"/>
        <Label x:Name="lblCopyMsg" Content="Copied!" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{x:Null}" FontSize="24" FontWeight="Bold" Foreground="#FF2CC335" Width="99" Height="43" RenderTransformOrigin="0.604,-0.782" Margin="220,93,0,0" Visibility="Hidden"/>
        <Image x:Name="picActive" HorizontalAlignment="Right" Height="142" VerticalAlignment="Top" Width="148" Source="/Designer.png" Stretch="Fill" RenderTransformOrigin="0.5,0.5" Margin="0,-6,0,0" d:IsHidden="True">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0"/>
                    <RotateTransform/>
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Image x:Name="picInactive" HorizontalAlignment="Right" Height="133" VerticalAlignment="Top" Width="148" Source="/inactive.png" Stretch="Fill"/>
        <Label Content="Username:" x:Name="lblUName" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.387,0.288"/>
        <Label Content="Domain:" x:Name="lblDM" HorizontalAlignment="Left" Margin="10,157,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.387,0.288"/>
        <Label Content="Password:" x:Name="lblPW" HorizontalAlignment="Left" Margin="10,183,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.387,0.288"/>
        <TextBox x:Name="txtUserName" HorizontalAlignment="Left" Margin="81,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="238" Height="21"/>
        <TextBox x:Name="txtDomain" HorizontalAlignment="Left" Margin="81,159,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="238" Height="21"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="81,185,0,0" VerticalAlignment="Top" Width="238" Height="21"/>
        <Image x:Name="picBoxLock" HorizontalAlignment="Right" Height="121" VerticalAlignment="Top" Width="122" Source="/lock_clean.png" Stretch="Fill" RenderTransformOrigin="0.5,0.5" Margin="0,126,10,0">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0"/>
                    <RotateTransform/>
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Button x:Name="btnCheckKioskMode" Content="Check K" HorizontalAlignment="Left" Margin="10,247,0,0" VerticalAlignment="Top" Width="72" Height="30" RenderTransformOrigin="0.166,-0.269"/>
        <Button x:Name="btnSetAutoLogon" Content="Activate" HorizontalAlignment="Left" Margin="87,247,0,0" VerticalAlignment="Top" Width="72" Height="30"/>
        <Button x:Name="btnDeactive" Content="Deactivate" HorizontalAlignment="Left" Margin="164,247,0,0" VerticalAlignment="Top" Width="72" Height="30"/>
        <Button x:Name="btnExit" Content="Exit" HorizontalAlignment="Left" Margin="241,247,0,0" VerticalAlignment="Top" Width="72" Height="30"/>
        <Button Content="" HorizontalAlignment="Left" Margin="324,186,0,0" VerticalAlignment="Top" Width="25" Height="20" RenderTransformOrigin="0.7,1.325" BorderBrush="#FF707070" Background="#FFF9F3B5"/>

    </Grid>
</Window>
